<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#131316"
    android:paddingTop="12dp">

    <!-- ═══════════════════ TOP MI HEADER ═══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:paddingTop="6dp">

        <!-- Mi Mode Tabs (Calculator / Converter / Finance) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Tab: Calculator -->
            <LinearLayout
                android:id="@+id/tabCalculator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvTabCalculator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculator"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
                <View
                    android:id="@+id/indicatorCalc"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="#FF6900" />
            </LinearLayout>

            <!-- Tab: Converter -->
            <LinearLayout
                android:id="@+id/tabConverter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvTabConverter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Converter"
                    android:textColor="#7A7A80"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
                <View
                    android:id="@+id/indicatorConv"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="#FF6900"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Tab: Finance -->
            <LinearLayout
                android:id="@+id/tabFinance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvTabFinance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finance"
                    android:textColor="#7A7A80"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
                <View
                    android:id="@+id/indicatorFin"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="#FF6900"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>

        <!-- Right Header Icons (Floating, History, Menu) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/btnFloatingWindow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛶"
                android:textColor="#A0A0A5"
                android:textSize="18sp"
                android:padding="6dp" />
            <TextView
                android:id="@+id/btnHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕒"
                android:textColor="#A0A0A5"
                android:textSize="16sp"
                android:padding="6dp"
                android:layout_marginStart="4dp" />
            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⋮"
                android:textColor="#A0A0A5"
                android:textSize="18sp"
                android:padding="6dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#202026"
        android:layout_marginBottom="4dp" />

    <!-- ═══════════════════ MAIN CONTENT PANELS ═══════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ─── PANEL 1: CALCULATOR VIEW ─── -->
        <LinearLayout
            android:id="@+id/panelCalculator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- DISPLAY AREA -->
            <LinearLayout
                android:id="@+id/displayPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|end"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvExpression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#7A7A80"
                    android:textSize="20sp"
                    android:gravity="end"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-light"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="72sp"
                    android:gravity="end"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <!-- MI QUICK SCIENTIFIC TOOLBAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/btn_paren_open"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="("
                    android:textColor="#FF6900"
                    android:textSize="16sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_paren_close"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text=")"
                    android:textColor="#FF6900"
                    android:textSize="16sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_sqrt"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="√"
                    android:textColor="#FF6900"
                    android:textSize="16sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_pi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="π"
                    android:textColor="#FF6900"
                    android:textSize="16sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_power"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="xʸ"
                    android:textColor="#FF6900"
                    android:textSize="15sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_toggle_sci"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🗩"
                    android:textColor="#7A7A80"
                    android:textSize="16sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- ═══════════════════ BUTTON GRID ═══════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <!-- ─── Row 0: C  ⌫  %  ÷ ─── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btn_ac"
                        style="@style/CalcBtn.Utility"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="C" />

                    <Button
                        android:id="@+id/btn_back"
                        style="@style/CalcBtn.Utility"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="⌫" />

                    <Button
                        android:id="@+id/btn_percent"
                        style="@style/CalcBtn.Utility"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="%" />

                    <Button
                        android:id="@+id/btn_div"
                        style="@style/CalcBtn.Operator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="÷" />
                </LinearLayout>

                <!-- ─── Row 1: 7  8  9  × ─── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btn_7"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="7" />

                    <Button
                        android:id="@+id/btn_8"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="8" />

                    <Button
                        android:id="@+id/btn_9"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="9" />

                    <Button
                        android:id="@+id/btn_mul"
                        style="@style/CalcBtn.Operator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="×" />
                </LinearLayout>

                <!-- ─── Row 2: 4  5  6  − ─── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btn_4"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="4" />

                    <Button
                        android:id="@+id/btn_5"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="5" />

                    <Button
                        android:id="@+id/btn_6"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="6" />

                    <Button
                        android:id="@+id/btn_minus"
                        style="@style/CalcBtn.Operator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="−" />
                </LinearLayout>

                <!-- ─── Row 3: 1  2  3  + ─── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btn_1"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="1" />

                    <Button
                        android:id="@+id/btn_2"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="2" />

                    <Button
                        android:id="@+id/btn_3"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="3" />

                    <Button
                        android:id="@+id/btn_plus"
                        style="@style/CalcBtn.Operator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="+" />
                </LinearLayout>

                <!-- ─── Row 4: ±  0  .  = ─── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_negate"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="±" />

                    <Button
                        android:id="@+id/btn_0"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="0" />

                    <Button
                        android:id="@+id/btn_dot"
                        style="@style/CalcBtn.Digit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="." />

                    <Button
                        android:id="@+id/btn_eq"
                        style="@style/CalcBtn.Equal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="=" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ─── PANEL 2: CONVERTER VIEW ─── -->
        <ScrollView
            android:id="@+id/panelConverter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Popular Converters"
                    android:textColor="#A0A0A5"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <!-- Grid of converter cards -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="true"
                    android:alignmentMode="alignMargins">

                    <!-- Currency -->
                    <LinearLayout
                        android:id="@+id/cardConvCurrency"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="#1C1C22"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💱"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Currency"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Length -->
                    <LinearLayout
                        android:id="@+id/cardConvLength"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="#1C1C22"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📏"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Length"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Area -->
                    <LinearLayout
                        android:id="@+id/cardConvArea"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="#1C1C22"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📐"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Area"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Volume -->
                    <LinearLayout
                        android:id="@+id/cardConvVolume"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="#1C1C22"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Volume"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Speed -->
                    <LinearLayout
                        android:id="@+id/cardConvSpeed"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="#1C1C22"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚗"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Speed"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Mass -->
                    <LinearLayout
                        android:id="@+id/cardConvMass"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="#1C1C22"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚖️"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mass"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </GridLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ─── PANEL 3: FINANCE VIEW ─── -->
        <ScrollView
            android:id="@+id/panelFinance"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Financial Calculators"
                    android:textColor="#A0A0A5"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <!-- Loan EMI -->
                <LinearLayout
                    android:id="@+id/cardFinLoan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1C1C22"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏠"
                        android:textSize="28sp"
                        android:layout_marginEnd="14dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loan / Mortgage EMI"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculate monthly installments &amp; interest"
                            android:textColor="#7A7A80"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- GST -->
                <LinearLayout
                    android:id="@+id/cardFinGST"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1C1C22"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧾"
                        android:textSize="28sp"
                        android:layout_marginEnd="14dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GST Calculator"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculate 5%, 12%, 18%, 28% GST slabs"
                            android:textColor="#7A7A80"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Discount -->
                <LinearLayout
                    android:id="@+id/cardFinDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1C1C22"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏷️"
                        android:textSize="28sp"
                        android:layout_marginEnd="14dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discount &amp; Sale"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculate final price and total savings"
                            android:textColor="#7A7A80"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Investment -->
                <LinearLayout
                    android:id="@+id/cardFinInvestment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1C1C22"
                    android:padding="16dp"
