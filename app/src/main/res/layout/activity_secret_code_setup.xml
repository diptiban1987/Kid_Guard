<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Secret Code"
            android:textColor="#6C63FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a numeric code.\nDial *#*CODE# to hide/show app."
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvCurrentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App is currently: VISIBLE"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1A1A2E"
            app:cardCornerRadius="16dp"
            app:strokeColor="#6C63FF"
            app:strokeWidth="1dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How it works"
                    android:textColor="#6C63FF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Set your secret numeric code\n2. Open phone dialer and dial *#*YOUR_CODE#\n3. App disappears from app drawer\n4. Dial *#*YOUR_CODE# again to bring it back\n5. Nobody will know this app exists on your phone!"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCurrentCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="#80FFFFFF"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCurrentCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter current secret code"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:inputType="numberPassword"
                android:maxLines="1"
                android:maxLength="15"
                android:padding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNewCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="#80FFFFFF"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="New secret code (4-15 digits)"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:inputType="numberPassword"
                android:maxLines="1"
                android:maxLength="15"
                android:padding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutConfirmCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="#80FFFFFF"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm new code"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:inputType="numberPassword"
                android:maxLines="1"
                android:maxLength="15"
                android:padding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Set Code"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#6C63FF"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleVisibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Hide/Show App Now"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:backgroundTint="#3949AB"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textSize="14sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="#80FFFFFF"
            app:strokeColor="#80FFFFFF"
            app:cornerRadius="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

</ScrollView>
