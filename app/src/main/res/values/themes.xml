<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AnonChat" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Theme.AnonChat.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <!-- ═══ Calculator Button Styles ═══ -->

    <!-- Base style for all calc buttons -->
    <style name="CalcBtn" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">36dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Digit buttons: dark grey #3A3A3C -->
    <style name="CalcBtn.Digit" parent="CalcBtn">
        <item name="backgroundTint">#3A3A3C</item>
        <item name="rippleColor">#66FFFFFF</item>
    </style>

    <!-- Operator buttons: amber orange #FF9500 -->
    <style name="CalcBtn.Operator" parent="CalcBtn">
        <item name="backgroundTint">#FF9500</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Utility buttons: medium grey #636366 -->
    <style name="CalcBtn.Utility" parent="CalcBtn">
        <item name="backgroundTint">#636366</item>
        <item name="rippleColor">#66FFFFFF</item>
    </style>

    <!-- Calculator full-screen theme: pure black bars -->
    <style name="Theme.Calculator" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">#1C1C1E</item>
        <item name="android:statusBarColor">#1C1C1E</item>
        <item name="android:navigationBarColor">#1C1C1E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
